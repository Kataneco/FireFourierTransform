#version 460

layout (local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout (set = 0, binding = 0, rgba32f) uniform image2D renderTexture;

layout (std140, set = 0, binding = 1) readonly buffer SpectrumBuffer {
    vec4 spectrum[];
} spectrumBuffer;

float key(float frequency) {
    return 12 * log2(frequency / 440.0) + 49;
}

float key_in_octave(float frequency) {
    const float key_number = key(frequency);
    return floor(key_number - int(key_number / 12.0) * 12);
}

vec3 hue2rgb(float hue) {
    hue = fract(hue);
    return pow(vec3(abs(hue * 6.0 - 3.0) - 1.0, 2.0 - abs(hue * 6.0 - 2.0), 2.0 - abs(hue * 6.0 - 4.0)), vec3(1.0/1.0));
}

const float AMP_PX = 228.0;
const float HALF_WIDTH = 1.6;
const float DASH_PERIOD = 16.0;
const float DASH_ON = 8.0;

//round-capped dash SDF: phase = arc length along the curve in px, dperp = distance to the curve in px
float dashDistance(float phase, float dperp) {
    float m = mod(phase, DASH_PERIOD);
    if (m > DASH_ON + (DASH_PERIOD - DASH_ON) * 0.5) m -= DASH_PERIOD;
    float dalong = max(abs(m - DASH_ON * 0.5) - DASH_ON * 0.5, 0.0);
    return length(vec2(dalong, dperp));
}

void main() {
    const float x = pow(10.0, 1.30103+float(gl_GlobalInvocationID.x) / 1000.0);
    const float y = gl_GlobalInvocationID.y;

    //vec4 color = imageLoad(renderTexture, ivec2(gl_GlobalInvocationID.x, y));
    //imageStore(renderTexture, ivec2(gl_GlobalInvocationID.x, y), vec4(color.xyz, 1));

    imageStore(renderTexture, ivec2(gl_GlobalInvocationID.x, y), vec4(vec3(0.0), 0.6));

    int index = int(x);

    float lxy = length(spectrumBuffer.spectrum[int(index)].xy) * log2(x);
    float lzw = length(spectrumBuffer.spectrum[int(index)].zw) * log2(x);

    if(x > 1000) {
        for(int i = 1; i <= 2; ++i) {
            lxy = max(lxy, length(spectrumBuffer.spectrum[int(index+i)].xy) * log2(x));
            lzw = max(lzw, length(spectrumBuffer.spectrum[int(index+i)].zw) * log2(x));
        }
    } else if(x > 2000) {
        for(int i = -2; i <= 2; ++i) {
            lxy = max(lxy, length(spectrumBuffer.spectrum[int(index+i)].xy) * log2(x));
            lzw = max(lzw, length(spectrumBuffer.spectrum[int(index+i)].zw) * log2(x));
        }
    } else if(x > 4000) {
        for(int i = -3; i <= 3; ++i) {
            lxy = max(lxy, length(spectrumBuffer.spectrum[int(index+i)].xy) * log2(x));
            lzw = max(lzw, length(spectrumBuffer.spectrum[int(index+i)].zw) * log2(x));
        }
    } else if(x > 8000) {
        for(int i = -5; i <= 5; ++i) {
            lxy = max(lxy, length(spectrumBuffer.spectrum[int(index+i)].xy) * log2(x));
            lzw = max(lzw, length(spectrumBuffer.spectrum[int(index+i)].zw) * log2(x));
        }
    }

    if ((912-y) < lxy-6) imageStore(renderTexture, ivec2(gl_GlobalInvocationID.x, y), vec4(hue2rgb(log2(x))*log(lxy/15)+0*vec3(spectrumBuffer.spectrum[int(index)].xy, 0.42), 1.0));
    if ((y) < lzw-6) imageStore(renderTexture, ivec2(gl_GlobalInvocationID.x, y), vec4(hue2rgb(log2(x))*log(lzw/15)+0*vec3(spectrumBuffer.spectrum[int(index)].zw, 0.42), 1.0));

    //waveform pass: distance to the polyline in pixel space, dash phase = cumulative screen-px arc length
    //(module buffer at 1764+ holds exclusive prefix sums uploaded by main.cpp)
    vec2 P = vec2(float(gl_GlobalInvocationID.x), y);
    int i = int(gl_GlobalInvocationID.x / 2u);

    float bestR = 1e9;
    float bestL = 1e9;
    for (int j = i - 2; j <= i + 1; ++j) {
        int jj = clamp(j, 0, 798);
        vec2 s0 = spectrumBuffer.spectrum[jj + 882].xz;
        vec2 s1 = spectrumBuffer.spectrum[jj + 883].xz;
        vec2 m0 = spectrumBuffer.spectrum[jj + 1764].xy;
        vec2 m1 = spectrumBuffer.spectrum[jj + 1765].xy;

        vec2 A = vec2(2.0 * float(jj), AMP_PX * s0.x + 456.0);
        vec2 B = vec2(2.0 * float(jj) + 2.0, AMP_PX * s1.x + 456.0);
        vec2 AB = B - A;
        float t = clamp(dot(P - A, AB) / dot(AB, AB), 0.0, 1.0);
        bestR = min(bestR, dashDistance(mix(m0.x, m1.x, t), distance(P, A + AB * t)));

        A.y = AMP_PX * s0.y + 456.0;
        B.y = AMP_PX * s1.y + 456.0;
        AB = B - A;
        t = clamp(dot(P - A, AB) / dot(AB, AB), 0.0, 1.0);
        bestL = min(bestL, dashDistance(mix(m0.y, m1.y, t), distance(P, A + AB * t)));
    }

    float aR = smoothstep(HALF_WIDTH + 0.75, HALF_WIDTH - 0.75, bestR);
    float aL = smoothstep(HALF_WIDTH + 0.75, HALF_WIDTH - 0.75, bestL);
    if (aR + aL > 0.004) {
        vec4 base = imageLoad(renderTexture, ivec2(gl_GlobalInvocationID.x, y));
        vec3 col = mix(base.xyz, vec3(0.0, 0.8, 1.0), aR);
        col = mix(col, vec3(1.0, 0.2, 0.0), aL);
        imageStore(renderTexture, ivec2(gl_GlobalInvocationID.x, y), vec4(col, 1.0));
    }
}
